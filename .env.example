# Copy this file to .env (or anywhere you like) and fill in your keys.
# Load it with: ouap --env-file /path/to/.env <command>
# Or export the variables in your shell before running ouap.

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Semantic Scholar (optional, for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Together AI (optional)
TOGETHER_API_KEY=

# Hugging Face (optional)
HF_API_KEY=
